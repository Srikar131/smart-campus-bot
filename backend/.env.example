# ---- Smart Campus Bot backend configuration ----
# Copy this file to ".env" and fill in your OpenAI key.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-key-here

# Models (defaults are good for most users)
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Frontend origin(s) allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Optional tuning
# DATA_DIR=./data
# CHUNK_SIZE=500
# CHUNK_OVERLAP=60
# TOP_K=4
# MAX_UPLOAD_MB=20
